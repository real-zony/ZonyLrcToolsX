<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZonyLrcTools.Desktop.ViewModels"
             xmlns:loc="using:ZonyLrcTools.Desktop.Infrastructure.Localization"
             x:Class="ZonyLrcTools.Desktop.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="24">
            <!-- Title -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding SettingsTitle}"
                           FontSize="24"
                           FontWeight="Bold" />
            </StackPanel>

            <!-- Language Settings -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BoxShadow="0 2 8 0 #0D000000"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding SettingsLanguage}"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <CheckBox Content="{Binding SettingsFollowSystem}"
                              IsChecked="{Binding FollowSystemLanguage}" />

                    <StackPanel Orientation="Horizontal" Spacing="16" IsEnabled="{Binding !FollowSystemLanguage}">
                        <RadioButton GroupName="Language"
                                     Content="{Binding SettingsChinese}"
                                     IsChecked="{Binding IsChineseSelected}" />
                        <RadioButton GroupName="Language"
                                     Content="{Binding SettingsEnglish}"
                                     IsChecked="{Binding IsEnglishSelected}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Network Settings -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BoxShadow="0 2 8 0 #0D000000"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding SettingsProxy}"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <CheckBox Content="{Binding SettingsProxyEnable}"
                              IsChecked="{Binding IsProxyEnabled}" />

                    <Grid ColumnDefinitions="*,Auto,120" IsEnabled="{Binding IsProxyEnabled}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ProxyIp}"
                                 Watermark="{Binding SettingsProxyAddress}"
                                 Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text=":"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <NumericUpDown Grid.Column="2"
                                       Value="{Binding ProxyPort}"
                                       Minimum="1"
                                       Maximum="65535" />
                    </Grid>

                    <TextBlock Text="{Binding SettingsProxyRestartHint}"
                               FontSize="12"
                               Opacity="0.55"
                               TextWrapping="Wrap"
                               IsVisible="{Binding IsProxyEnabled}" />
                </StackPanel>
            </Border>

            <!-- Lyrics Settings -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BoxShadow="0 2 8 0 #0D000000"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding SettingsLyricsSection}"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <CheckBox Content="{Binding SettingsEnableTranslation}"
                              IsChecked="{Binding IsTranslationEnabled}" />

                    <CheckBox Content="{Binding SettingsOneLineMode}"
                              IsChecked="{Binding IsOneLineMode}"
                              IsEnabled="{Binding IsTranslationEnabled}" />

                    <CheckBox Content="{Binding SettingsOnlyTranslation}"
                              IsChecked="{Binding IsOnlyOutputTranslation}"
                              IsEnabled="{Binding IsTranslationEnabled}" />

                    <CheckBox Content="{Binding SettingsSkipExisting}"
                              IsChecked="{Binding SkipExistingLyrics}" />

                    <Grid ColumnDefinitions="Auto,180,Auto,180" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding SettingsFileEncoding}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding AvailableEncodings}"
                                  SelectedItem="{Binding SelectedEncoding}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding SettingsLineBreak}"
                                   VerticalAlignment="Center"
                                   Margin="24,0,12,0" />
                        <ComboBox Grid.Row="0" Grid.Column="3"
                                  ItemsSource="{Binding LineBreakDisplayNames}"
                                  SelectedIndex="{Binding SelectedLineBreakIndex}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Lyrics Providers -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BoxShadow="0 2 8 0 #0D000000"
                    Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SettingsLyricsProvider}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SettingsProviderOrderHint}"
                                   FontSize="12"
                                   Opacity="0.55"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding LyricsProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LyricsProviderSettingViewModel">
                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,4"
                                        Opacity="{Binding RowOpacity}">
                                    <Grid ColumnDefinitions="Auto,28,*,Auto,Auto">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled}"
                                                  Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PriorityLabel}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource NumericFontFamily}"
                                                   Opacity="0.55" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3"
                                                Command="{Binding MoveUpCommand}"
                                                IsEnabled="{Binding CanMoveUp}"
                                                Classes="icon"
                                                Margin="0,0,4,0"
                                                ToolTip.Tip="{loc:Localize Settings_MoveUp}">
                                            <PathIcon Data="{StaticResource ChevronUpIcon}" Width="12" Height="12" />
                                        </Button>
                                        <Button Grid.Column="4"
                                                Command="{Binding MoveDownCommand}"
                                                IsEnabled="{Binding CanMoveDown}"
                                                Classes="icon"
                                                ToolTip.Tip="{loc:Localize Settings_MoveDown}">
                                            <PathIcon Data="{StaticResource ChevronDownIcon}" Width="12" Height="12" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Advanced Settings (collapsed by default) -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BoxShadow="0 2 8 0 #0D000000"
                    Padding="24">
                <StackPanel Spacing="16">
                    <ToggleSwitch IsChecked="{Binding IsAdvancedVisible}"
                                  Content="{Binding SettingsShowAdvanced}"
                                  OnContent="{Binding SettingsAdvancedSection}"
                                  OffContent="{Binding SettingsShowAdvanced}" />

                    <StackPanel Spacing="16" IsVisible="{Binding IsAdvancedVisible}">
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Opacity="0.5" />

                        <!-- Romanized output -->
                        <CheckBox Content="{Binding SettingsRomanOutput}"
                                  IsChecked="{Binding IsRomanOutputEnabled}" />

                        <!-- Block word dictionary -->
                        <TextBlock Text="{Binding SettingsBlockWordSection}"
                                   FontSize="15"
                                   FontWeight="Medium" />

                        <CheckBox Content="{Binding SettingsBlockWordEnable}"
                                  IsChecked="{Binding IsBlockWordEnabled}" />

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SettingsBlockWordPath}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding BlockWordFilePath}"
                                     IsEnabled="{Binding IsBlockWordEnabled}" />
                        </Grid>

                        <!-- Tag providers -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SettingsTagProvider}"
                                       FontSize="15"
                                       FontWeight="Medium" />
                            <TextBlock Text="{Binding SettingsProviderOrderHint}"
                                       FontSize="12"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding TagProviders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TagInfoProviderSettingViewModel">
                                    <Border Background="{DynamicResource AppBackgroundBrush}"
                                            CornerRadius="4"
                                            Padding="12,8"
                                            Margin="0,4"
                                            Opacity="{Binding RowOpacity}">
                                        <Grid ColumnDefinitions="Auto,28,*,Auto,Auto">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled}"
                                                      Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PriorityLabel}"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.55" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Command="{Binding MoveUpCommand}"
                                                    IsEnabled="{Binding CanMoveUp}"
                                                    Classes="icon"
                                                    Margin="0,0,4,0"
                                                    ToolTip.Tip="{loc:Localize Settings_MoveUp}">
                                                <PathIcon Data="{StaticResource ChevronUpIcon}" Width="12" Height="12" />
                                            </Button>
                                            <Button Grid.Column="4"
                                                    Command="{Binding MoveDownCommand}"
                                                    IsEnabled="{Binding CanMoveDown}"
                                                    Classes="icon"
                                                    ToolTip.Tip="{loc:Localize Settings_MoveDown}">
                                                <PathIcon Data="{StaticResource ChevronDownIcon}" Width="12" Height="12" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions + status -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BoxShadow="0 2 8 0 #0D000000"
                    Padding="24,14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StorageHint}"
                                   FontSize="12"
                                   Opacity="0.55"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SaveStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SuccessColorBrush}"
                                   IsVisible="{Binding ShowSaveSuccess}" />
                        <TextBlock Text="{Binding SaveStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource ErrorColorBrush}"
                                   IsVisible="{Binding ShowSaveFailure}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{Binding SettingsReset}"
                            Command="{Binding ResetToDefaultsCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
