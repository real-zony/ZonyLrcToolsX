<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZonyLrcTools.Desktop.Views.Dialogs.MessageDialog"
        Title=""
        Width="480"
        MaxHeight="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto">
        <!-- Title -->
        <TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <!-- Message. 用只读 TextBox 而不是 TextBlock，这样正文可以被选中复制。 -->
        <TextBox Grid.Row="1"
                 x:Name="MessageText"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxHeight="380"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="0"
                 Margin="0,0,0,20" />

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="CopyButton"
                    MinWidth="88"
                    Click="OnCopyClick" />
            <Button x:Name="OkButton"
                    MinWidth="88"
                    Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
